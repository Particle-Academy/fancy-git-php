{
    "name": "particle-academy/fancy-git",
    "description": "Framework-agnostic Git toolkit and normalized provider contracts for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "FancyGit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyGit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/Particle-Academy/fancy-git-php/issues",
        "source": "https://github.com/Particle-Academy/fancy-git-php"
    }
}
